# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Test, coverage, and local run output
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
runs/

# Editor and OS clutter
.DS_Store
*.swp

# Secrets. Never commit the OpenRouter key.
.env
.env.*
!.env.example

# Campaign viewer. Source lives in viewer/src; tsc writes viewer/dist.
viewer/node_modules/
viewer/dist/

# Local artifacts from paid runs.
# results/summaries/, results/raw/, and results/*.json are the published
# measurement. Those traces are small and stay tracked. results/raw/ is the
# call log; scripts/make_report.py rebuilds the report from the summaries.
results/libraries/
results/**/*.tmp
results/last_error.txt
